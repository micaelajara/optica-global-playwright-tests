ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambiar

# Publishable key del storefront (Store API), no es secreta pero varía por
# ambiente — se pide como env var en vez de tenerla hardcodeada en el repo.
MEDUSA_PUBLISHABLE_KEY=pk_ejemplo

# Cliente de prueba (@yopmail.com) con al menos un pedido ya hecho —
# hace falta un pedido previo para poder loguearse, ver el bug de login
# documentado en el README. Usado por tests/optica-global/setup-auth.js
# para generar el storageState real.
CUSTOMER_EMAIL=tu-cuenta-de-prueba@yopmail.com
