ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Storefront publishable key (Store API), not secret but varies per
# environment — required as an env var instead of hardcoding it in the repo.
MEDUSA_PUBLISHABLE_KEY=pk_example

# Test account (@yopmail.com) with at least one order already placed — a
# prior order is required to be able to log in, see the login flow
# documented in the README. Used by tests/optica-global/setup-auth.js to
# generate the real storageState.
CUSTOMER_EMAIL=your-test-account@yopmail.com
